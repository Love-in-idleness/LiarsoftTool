file(MAKE_DIRECTORY "${TEST_ROOT}")
execute_process(COMMAND ${EMULATOR} "${FIXTURE}" "${TEST_ROOT}" RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Cannot produce EXE fixture: ${log} ${error}")
endif()
set(source "${TEST_ROOT}/中文 Русский space/game.exe")
file(MAKE_DIRECTORY "${TEST_ROOT}/中文 Русский space")
file(COPY "${TEST_ROOT}/game.exe" DESTINATION "${TEST_ROOT}/中文 Русский space")
file(SHA256 "${source}" before)
execute_process(COMMAND ${EMULATOR} "${TOOL}" --experimental-exe --exe-show "${source}" RESULT_VARIABLE code OUTPUT_VARIABLE report ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT report MATCHES "128.CP932" OR NOT report MATCHES "text:3300" OR NOT report MATCHES "no_line_start")
    message(FATAL_ERROR "EXE inspection failed: ${code} ${report} ${error}")
endif()
set(output "${TEST_ROOT}/中文 Русский space/translated.exe")
execute_process(COMMAND ${EMULATOR} "${TOOL}" --experimental-exe "${source}" -e gbk --exe-set-text "text:3300=保存文件 %s" --exe-set-text "text:3340=确认" --exe-no-line-start ";" --exe-no-line-end "(" -o "${output}"
    RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "EXE modification failed: ${code} ${log} ${error}")
endif()
execute_process(COMMAND ${EMULATOR} "${TOOL}" --experimental-exe --exe-show "${output}" RESULT_VARIABLE code OUTPUT_VARIABLE report ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT report MATCHES "134.GBK" OR NOT report MATCHES "保存文件" OR NOT report MATCHES "no_line_start: \";\"")
    message(FATAL_ERROR "Changed EXE cannot be inspected: ${report} ${error}")
endif()
file(SHA256 "${source}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "EXE source changed")
endif()
file(SHA256 "${output}" expected)
foreach(mode disabled readwrite conflict unsupported)
    if(mode STREQUAL disabled)
        set(args --exe-show "${source}")
    elseif(mode STREQUAL readwrite)
        set(args --experimental-exe --exe-show "${source}" -o "${output}")
    elseif(mode STREQUAL conflict)
        set(args --experimental-exe "${source}" --exe-kinsoku missing.json --exe-no-line-end "(" -o "${output}")
    else()
        set(args --experimental-exe "${source}" -e gb18030 -o "${output}")
    endif()
    execute_process(COMMAND ${EMULATOR} "${TOOL}" ${args} RESULT_VARIABLE code ERROR_VARIABLE error)
    file(SHA256 "${output}" actual)
    if(NOT code EQUAL 1 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Rejected EXE operation wrote output: ${mode}: ${code} ${error}")
    endif()
endforeach()
execute_process(COMMAND ${EMULATOR} "${TOOL}" -e gbk "${source}" RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR NOT error MATCHES "unsupported file extension")
    message(FATAL_ERROR "EXE became an ordinary conversion input: ${error}")
endif()

file(WRITE "${TEST_ROOT}/rules.json" "{\"version\":1,\"no_line_start\":\";\",\"no_line_end\":\"(\"}")
execute_process(COMMAND ${EMULATOR} "${TOOL}" --experimental-exe "${source}" --exe-kinsoku "${TEST_ROOT}/rules.json" -o "${TEST_ROOT}/rules.exe"
    RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "EXE rule JSON failed: ${error}")
endif()

execute_process(COMMAND ${EMULATOR} "${TOOL}" --experimental-exe "${source}" -e GBK --exe-defaults --exe-set-text "text:3340=自定义" -o "${TEST_ROOT}/defaults.exe"
    RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "EXE default configuration failed: ${error}")
endif()
execute_process(COMMAND ${EMULATOR} "${TOOL}" --experimental-exe --exe-show "${TEST_ROOT}/defaults.exe" RESULT_VARIABLE code OUTPUT_VARIABLE report)
if(NOT code EQUAL 0 OR NOT report MATCHES "自定义")
    message(FATAL_ERROR "EXE defaults overwrote explicit text: ${report}")
endif()
