file(MAKE_DIRECTORY "${TEST_ROOT}/中文 path")
set(source "${TEST_ROOT}/中文 path/source.tsc")
file(WRITE "${source}" ";@gsc-byte-format modern-36\n;@gsc-schema modern\n:entry\n*font 1 0 0 0 0 \"中文😀\"\n*goto entry\n")
execute_process(COMMAND "${TOOL}" --inspect-tsc "${source}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT error STREQUAL "" OR NOT output MATCHES "\"version\":1" OR NOT output MATCHES "\"role\":\"target\"")
    message(FATAL_ERROR "Inspection failed: ${output} ${error}")
endif()
execute_process(COMMAND "${TOOL}" --inspect-tsc - INPUT_FILE "${source}" RESULT_VARIABLE code OUTPUT_VARIABLE stdinOutput)
if(NOT code EQUAL 0 OR NOT output STREQUAL stdinOutput)
    message(FATAL_ERROR "stdin and file inspection differ")
endif()
file(WRITE "${source}" "broken")
execute_process(COMMAND "${TOOL}" --inspect-tsc "${source}" RESULT_VARIABLE code OUTPUT_VARIABLE output)
if(NOT code EQUAL 1 OR NOT output MATCHES "\"severity\":\"error\"")
    message(FATAL_ERROR "Invalid inspection is not JSON")
endif()
foreach(option -R --check-tsc --pack-only --check-update)
    execute_process(COMMAND "${TOOL}" --inspect-tsc ${option} "${source}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL 1 OR NOT error MATCHES "cannot be combined")
        message(FATAL_ERROR "Inspection accepted mutation options")
    endif()
endforeach()
if(EXISTS "${TEST_ROOT}/中文 path/source.gsc")
    message(FATAL_ERROR "Inspection wrote GSC")
endif()
