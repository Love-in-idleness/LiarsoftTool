file(MAKE_DIRECTORY "${TEST_ROOT}")
execute_process(COMMAND "${FIXTURES}" "${TEST_ROOT}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "GSC detection fixtures failed")
endif()
execute_process(COMMAND "${TOOL}" -o "${TEST_ROOT}/default.tsc" "${TEST_ROOT}/chinese.gsc"
    RESULT_VARIABLE code ERROR_VARIABLE warnings)
if(NOT code EQUAL 0 OR NOT warnings MATCHES "GSC input encoding: GBK")
    message(FATAL_ERROR "Default encoding is not auto: ${warnings}")
endif()
execute_process(COMMAND "${TOOL}" -e AUTO -o "${TEST_ROOT}/auto.tsc" "${TEST_ROOT}/chinese.gsc"
    RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Explicit auto failed")
endif()
execute_process(COMMAND "${TOOL}" -e GBK -o "${TEST_ROOT}/manual.tsc" "${TEST_ROOT}/chinese.gsc"
    RESULT_VARIABLE code ERROR_VARIABLE warnings)
if(NOT code EQUAL 0 OR NOT warnings STREQUAL "")
    message(FATAL_ERROR "Manual encoding did not bypass detection: ${warnings}")
endif()
file(READ "${TEST_ROOT}/default.tsc" expected)
foreach(name auto manual)
    file(READ "${TEST_ROOT}/${name}.tsc" text)
    if(NOT text STREQUAL expected)
        message(FATAL_ERROR "${name} differs from default auto")
    endif()
endforeach()
file(WRITE "${TEST_ROOT}/short.tsc" "KEEP")
execute_process(COMMAND "${TOOL}" "${TEST_ROOT}/short.gsc" RESULT_VARIABLE code ERROR_VARIABLE error)
file(READ "${TEST_ROOT}/short.tsc" text)
if(NOT code EQUAL 1 OR NOT text STREQUAL "KEEP" OR NOT error MATCHES "candidates")
    message(FATAL_ERROR "Inconclusive detection did not preserve old output: ${error}")
endif()
execute_process(COMMAND "${TOOL}" -e CP932 "${TEST_ROOT}/short.gsc" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Manual override failed for short text")
endif()
execute_process(COMMAND "${TOOL}" -R -o "${TEST_ROOT}/unpacked" "${TEST_ROOT}/archive.xfl"
    RESULT_VARIABLE code ERROR_VARIABLE warnings)
file(READ "${TEST_ROOT}/unpacked/chinese.tsc" unpacked)
# The generated-from comment records the actual input path.
string(REGEX REPLACE "; generated from [^\n]*\n" "" expected "${expected}")
string(REGEX REPLACE "; generated from [^\n]*\n" "" unpacked "${unpacked}")
if(NOT code EQUAL 0 OR NOT unpacked STREQUAL expected OR NOT warnings MATCHES "GSC input encoding: GBK")
    message(FATAL_ERROR "Recursive archive did not use auto: ${warnings}")
endif()
file(WRITE "${TEST_ROOT}/target.gsc" "KEEP")
execute_process(COMMAND "${TOOL}" --check-tsc --diagnostics=json "${TEST_ROOT}/manual.tsc"
    RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR NOT error MATCHES "explicit target encoding")
    message(FATAL_ERROR "Check mode silently picked a target encoding")
endif()
execute_process(COMMAND "${TOOL}" -o "${TEST_ROOT}/target.gsc" "${TEST_ROOT}/manual.tsc"
    RESULT_VARIABLE code ERROR_VARIABLE error)
file(READ "${TEST_ROOT}/target.gsc" text)
if(NOT code EQUAL 1 OR NOT text STREQUAL "KEEP" OR NOT error MATCHES "explicit")
    message(FATAL_ERROR "Auto guessed an output encoding: ${error}")
endif()
execute_process(COMMAND "${TOOL}" -e GBK -o "${TEST_ROOT}/target.gsc" "${TEST_ROOT}/manual.tsc"
    RESULT_VARIABLE code)
file(SHA256 "${TEST_ROOT}/target.gsc" actual)
file(SHA256 "${TEST_ROOT}/chinese.gsc" original)
if(NOT code EQUAL 0 OR NOT actual STREQUAL original)
    message(FATAL_ERROR "Explicit target failed roundtrip")
endif()
foreach(encoding utf-8 UTF_8 65001 cp65001)
    execute_process(COMMAND "${TOOL}" --check-tsc -e "${encoding}" "${TEST_ROOT}/manual.tsc"
        RESULT_VARIABLE code ERROR_VARIABLE error)
    if(NOT code EQUAL 1 OR NOT error MATCHES "Unsupported resource encoding")
        message(FATAL_ERROR "UTF-8 resource encoding was accepted: ${encoding}: ${error}")
    endif()
endforeach()
