execute_process(COMMAND "${BMP_TEST}" "${TEST_ROOT}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "BMP unit tests failed: ${status}")
endif()
foreach(repeat RANGE 1 2)
    execute_process(COMMAND "${TOOL}" --unpack-only "${TEST_ROOT}/cli.bmp"
                    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 0 OR NOT output MATCHES "CodeX BMP -> BMP" OR errors)
        message(FATAL_ERROR "BMP CLI failed: ${status}: ${output} ${errors}")
    endif()
    file(SHA256 "${TEST_ROOT}/cli.bmp" actual)
    file(SHA256 "${TEST_ROOT}/output.bmp" expected)
    file(TIMESTAMP "${TEST_ROOT}/cli.bmp" actual_time "%s")
    file(TIMESTAMP "${TEST_ROOT}/input.bmp" expected_time "%s")
    if(NOT actual STREQUAL expected OR NOT actual_time STREQUAL expected_time)
        message(FATAL_ERROR "BMP CLI differs from public API or changed source time")
    endif()
endforeach()
