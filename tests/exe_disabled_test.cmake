file(MAKE_DIRECTORY "${TEST_ROOT}")
set(input "${TEST_ROOT}/game.exe")
set(output "${TEST_ROOT}/unchanged.bin")
file(WRITE "${input}" "MZ original game")
file(WRITE "${output}" "KEEP OUTPUT")
file(SHA256 "${input}" before)
execute_process(COMMAND "${TOOL}" -e gbk -o "${output}" "${input}"
    RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR NOT error MATCHES "unsupported file extension")
    message(FATAL_ERROR "EXE conversion was not rejected: ${code} ${log} ${error}")
endif()
file(SHA256 "${input}" after)
file(READ "${output}" previous)
if(NOT before STREQUAL after OR NOT previous STREQUAL "KEEP OUTPUT")
    message(FATAL_ERROR "Rejected EXE conversion changed an input or output")
endif()
execute_process(COMMAND "${TOOL}" -h RESULT_VARIABLE code OUTPUT_VARIABLE help)
if(NOT code EQUAL 0 OR help MATCHES "Set EXE charset|game.exe|\\.gbk\\.exe")
    message(FATAL_ERROR "CLI help still advertises EXE conversion")
endif()
